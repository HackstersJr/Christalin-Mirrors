# Copy to .env for local development. Never commit .env.
#
# Matches src/config/env.ts exactly. Note what is NOT here:
#   JWT_REFRESH_SECRET  — v1 has no refresh token (see MVP_DEFERRED_TECH_DEBT.md)
#   JWT_ISSUER          — hardcoded as 'christalin-mirrors' in src/utils/jwt.ts
#   CLOUDINARY_*        — optional; the upload helper is not wired to any route

NODE_ENV=development

# Backend listens here. The frontend's VITE_API_BASE_URL must match.
PORT=4000

# Host port 5433 matches docker-compose.dev.yml.
DATABASE_URL=postgresql://christalin:christalin_dev_password@localhost:5433/christalin_dev?schema=public

# Minimum 32 characters. Generate a real one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=local_dev_only_change_me_at_least_32_characters_long

# Used for the CORS allowlist.
FRONTEND_URL=http://localhost:5173

# ─── Seed only (prisma/seed.ts) ─────────────────────────────
# Required. Minimum 12 characters. The seed refuses to run with NODE_ENV=production.
SEED_OWNER_EMAIL=owner@christalin.local
SEED_OWNER_PASSWORD=StrongLocalPassword123!
